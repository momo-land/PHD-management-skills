{
  "name": "phd-management-skills",
  "version": "0.2.0",
  "private": true,
  "description": "Local research workspace and portable AI skills for PhD research management",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
